# Earth.data

# planetary info
radius: 6371.0 # km
surfaceG: 9.81 # m/s^2
dayLength: 1.0 # julian days

surfaceMaterial: Assets/GameData/CelestialBodies/Earth/Surface.mat
glowColor: "#9ddeff"

# atmospheric data, set to false if no atmosphere
atmosphere:
  # height to which we simulate atmospheric effects
  height: 100.0 # km

  # pressure characteristics
  seaLevelPressure: 1.0 # atm
  scaleHeight: 8.5 # km

  # atmospheric rendering - scattering
  material: Assets/Materials/Atmosphere.mat
  rayleighScattering: 5.804542996261093e-6, 1.3562911419845635e-5, 3.026590629238531e-5, 1.2619774364741572e-5
  mieScattering: 7.1e-6, 7.1e-6, 7.1e-6, 7.1e-6
  miePhaseG: 0.6
