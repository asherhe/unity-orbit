# Yerb.data

name: Yerb
color: "#828e9c"

# planetary info
radius: 400.0 # km
surfaceGravity: 1.2 # m/s^2
dayLength: 123.98 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Yerf
  semimajorAxis: 4.92e4 # km
  eccentricity: 0.034
  longitudePeriapsis: 0.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
