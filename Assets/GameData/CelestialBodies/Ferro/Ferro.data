# Ferro.data

name: Ferro
color: "#b8766d"

# planetary info
radius: 2100.0 # km
surfaceGravity: 23.1 # m/s^2
dayLength: 164.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Sun
  semimajorAxis: 1.5e8 # km
  eccentricity: 0.007
  longitudePeriapsis: 254.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
