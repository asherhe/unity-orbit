# Sun.data

name: Sun
color: "#EDDC4F"

# planetary info
radius: 600000.0 # km
surfaceGravity: 286 # m/s^2
dayLength: 614.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#FFFFFF"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit: false

# atmospheric data, set to false if no atmosphere
atmosphere: false # TODO, figure out how sun's atmosphere works

customDisplayPrefabs:
  - Assets/GameData/CelestialBodies/Sun/Lens Flare.prefab
