# Hamswell.data

name: Hamswell
color: "#729DE0"

# planetary info
radius: 3000.0 # km
surfaceGravity: 9.8 # m/s^2
dayLength: 24.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/Surface.mat
  properties:
    _MainTex:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Hamswell/Hamswell.png
    _SpecularTex:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Hamswell/Hamswell-Specular.png
    _NormalMap:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Hamswell/Hamswell-Normal.png
    _LightTex:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Hamswell/Hamswell-Lights.png
    _LightColor:
      type: Color
      value: "#FFF8B133"
    _HasAtmosphere:
      type: Integer
      value: 1

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Sun
  semimajorAxis: 9.2e7 # km
  eccentricity: 0.015
  longitudePeriapsis: 0.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere:
  # height to which we simulate atmospheric effects
  height: 80.0 # km

  # pressure characteristics
  seaLevelPressure: 1.0 # atm
  scaleHeight: 5.0 # km

  # atmospheric rendering - scattering
  material:
    path: Assets/GameData/CelestialBodies/Atmosphere.mat
    properties:
      _RayleighScaleHeight:
        type: Float
        value: 5000
      _MieScaleHeight:
        type: Float
        value: 800
      _RayleighScatteringCoeff:
        type: Vector
        value: [5.804542996261093e-6, 1.3562911419845635e-5, 3.026590629238531e-5, 1.2619774364741572e-5]
      _MieScatteringCoeff:
        type: Vector
        value: [7.1e-6, 7.1e-6, 7.1e-6, 7.1e-6]
      _MiePhaseG:
        type: Float
        value: 0.6

planetShine:
  color: "#81b8fc"
  intensity: 0.2
