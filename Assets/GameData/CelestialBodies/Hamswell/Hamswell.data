# Hamswell.data

name: Hamswell

# planetary info
radius: 3000.0 # km
surfaceGravity: 9.8 # m/s^2
dayLength: 24.0 # hours

surfaceMaterial: Assets/GameData/CelestialBodies/Hamswell/Surface.mat

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Sun
  semimajorAxis: 9.2e7 # km
  eccentricity: 0.015
  longitudePeriapsis: 0.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere:
  # height to which we simulate atmospheric effects
  height: 80.0 # km

  # pressure characteristics
  seaLevelPressure: 1.0 # atm
  scaleHeight: 5.0 # km

  # atmospheric rendering - scattering
  material: Assets/GameData/CelestialBodies/Atmosphere.mat
  rayleighScattering: [5.804542996261093e-6, 1.3562911419845635e-5, 3.026590629238531e-5, 1.2619774364741572e-5]
  mieScattering: [7.1e-6, 7.1e-6, 7.1e-6, 7.1e-6]
  miePhaseG: 0.6
