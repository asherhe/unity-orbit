# Gus.data

name: Gus
color: "#a270ca"

# planetary info
radius: 50000.0 # km
surfaceGravity: 34.6 # m/s^2
dayLength: 9.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/Surface.mat
  properties:
    _MainTex:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Gus/Gus.png

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Sun
  semimajorAxis: 3.0e8 # km
  eccentricity: 0.067
  longitudePeriapsis: 13.0 # deg
  epochMeanAnom: 65.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere:
  # height to which we simulate atmospheric effects
  height: 500.0 # km

  # pressure characteristics
  seaLevelPressure: 1.0 # atm
  scaleHeight: 30.0 # km

  # atmospheric rendering - scattering
  material:
    path: Assets/GameData/CelestialBodies/Atmosphere.mat
    properties:
      _RayleighScaleHeight:
        type: Float
        value: 30000
      _MieScaleHeight:
        type: Float
        value: 12000
      _RayleighScatteringCoeff:
        type: Vector
        value: [4.9e-5, 1.4e-6, 7.3e-5, 1.1e-5]
      _MieScatteringCoeff:
        type: Vector
        value: [7.1e-6, 7.1e-6, 7.1e-6, 7.1e-6]
      _MiePhaseG:
        type: Float
        value: 0.6

planetShine:
  color: "#da8bff"
  intensity: 0.2
