# Yerp.data

name: Yerp
color: "#887a67"

# planetary info
radius: 113.0 # km
surfaceGravity: 0.24 # m/s^2
dayLength: 19.70 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Yerf
  semimajorAxis: 7.81e4 # km
  eccentricity: 0.23
  longitudePeriapsis: 0.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
