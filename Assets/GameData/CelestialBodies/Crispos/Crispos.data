# Crispos.data

name: Crispos
color: "#bda475"

# planetary info
radius: 730.0 # km
surfaceGravity: 2.2 # m/s^2
dayLength: 23.74 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Gus
  semimajorAxis: 2.52e5 # km
  eccentricity: 0.006
  longitudePeriapsis: 0.0 # deg
  epochMeanAnom: 0.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
