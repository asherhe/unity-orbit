# Mozza.data

name: Mozza
color: "#E3C481"

# planetary info
radius: 800.0 # km
surfaceGravity: 2.5 # m/s^2
dayLength: 24.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/Surface.mat
  properties:
    _MainTex:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Mozza/Mozza.png
    _NormalMap:
      type: Texture2D
      value: Assets/GameData/CelestialBodies/Mozza/Mozza-Normal.png
    _SunAmp:
      type: Float
      value: 0.05

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Hamswell
  semimajorAxis: 1.88e5 # km
  eccentricity: 0.062
  longitudePeriapsis: 126.0 # deg
  epochMeanAnom: 102.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
