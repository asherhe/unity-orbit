# Micros.data

name: Micros
color: "#8db98b"

# planetary info
radius: 26.0 # km
surfaceGravity: 0.041 # m/s^2
dayLength: 16.4 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Gus
  semimajorAxis: 1.43e6 # km
  eccentricity: 0.31
  longitudePeriapsis: 163.0 # deg
  epochMeanAnom: 46.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere: false
