# Discus.data

name: Discus
color: "#82b5d3"

# planetary info
radius: 20000.0 # km
surfaceGravity: 10.7 # m/s^2
dayLength: 11.0 # hours

surfaceMaterial:
  path: Assets/GameData/CelestialBodies/SurfaceBlank.mat
  properties:
    _Color:
      type: Color
      value: "#181717"

# orbital info, set to false if there is no orbit (i.e. the Sun)
orbit:
  parent: Sun
  semimajorAxis: 5.5e8 # km
  eccentricity: 0.052
  longitudePeriapsis: 329.0 # deg
  epochMeanAnom: 219.0 # deg
  epochTime: 0.0 # s

# atmospheric data, set to false if no atmosphere
atmosphere:
  # height to which we simulate atmospheric effects
  height: 600.0 # km

  # pressure characteristics
  seaLevelPressure: 1.0 # atm
  scaleHeight: 40.0 # km

  # atmospheric rendering - scattering
  material:
    path: Assets/GameData/CelestialBodies/Atmosphere.mat
    properties:
      _RayleighScaleHeight:
        type: Float
        value: 5000
      _MieScaleHeight:
        type: Float
        value: 800
      _RayleighScatteringCoeff:
        type: Vector
        value: [5.804542996261093e-6, 1.3562911419845635e-5, 3.026590629238531e-5, 1.2619774364741572e-5]
      _MieScatteringCoeff:
        type: Vector
        value: [7.1e-6, 7.1e-6, 7.1e-6, 7.1e-6]
      _MiePhaseG:
        type: Float
        value: 0.6
