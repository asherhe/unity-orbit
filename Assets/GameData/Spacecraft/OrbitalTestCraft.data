# OrbitalTestCraft.data

name: Orbital Test Craft

orbit:
  # parent: Hamswell
  # h: 1.73e10
  parent: Gus
  h: 5e12
  e: 0.08
  omega: 1
  M0: 1
  t0: 0

rotation:
  angle: 2.7 # rad
  momentum: -1000 # kg m^2 s^-1

parts:
  - type: TestingCommandPod
    id: TestingCommandPod_1
    name: Testing Command Pod

    transform:
      pos: { x: 0.0, y: 0.0 }
      rot: 0

    attachments:
      - mode: Node
        node: bottom
        atchPart: TestingTank_2 # attached part
        atchNode: top # attachment node of attached part

    plugins:
      SpriteRendererPlugin:
        enabled: true
      CommandPlugin:
        enabled: true
      ReactionWheelPlugin:
        enabled: true

  - type: TestingTank
    id: TestingTank_2
    name: Testing Tank

    transform:
      pos: { x: 0.0, y: -2.0 }
      rot: 0

    attachments:
      - mode: Node
        node: top
        atchPart: TestingCommandPod_1
        atchNode: bottom
      - mode: Node
        node: bottom
        atchPart: TestingEngine_3
        atchNode: top

    plugins:
      SpriteRendererPlugin:
        enabled: true
      ResourceContainerPlugin:
        enabled: true
        amount:
          NTO: 3600
          Hydrazine: 2400
        priority:
          NTO: 0
          Hydrazine: 0

  - type: TestingEngine
    id: TestingEngine_3
    name: Testing Engine

    transform:
      pos: { x: 0.0, y: -3.75 }
      rot: 0

    attachments:
      - mode: Node
        node: top
        atchPart: TestingTank_2
        atchNode: bottom

    plugins:
      SpriteRendererPlugin:
        enabled: true
      EnginePlugin:
        enabled: true
