# TestingCommandPod.data

name: Testing Command Pod
mass: 0.8 # t
crossfeed: true

attachmentNodes:
  - name: top
    pos: { x: 0.0, y: 1.0 }
  - name: bottom
    pos: { x: 0.0, y: -1.0 }

plugins:
  SpriteRendererPlugin:
    sprite: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod.png
    material:
      path: Assets/GameData/Parts/Part.mat
      properties:
        _NormalMap:
          type: Texture2D
          value: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod-Normal.png
        _EmissionTex:
          type: Texture2D
          value: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod-Light.png
  LightPlugin:
    lightPosition: { x: 0, y: -0.125 }
    color: "#FFECB1"
    intensity: 0.13
    innerRadius: 0.25
    outerRadius: 1.68
    falloff: 0.89
  CommandPlugin:
    autoSteerable: true
  ReactionWheelPlugin:
    torque: 5 # kN m
