# TestingCommandPod.data

name: Testing Command Pod
mass: 0.8 # t
crossfeed: true

attachmentNodes:
  - name: top
    pos: { x: 0.0, y: 1.0 }
  - name: bottom
    pos: { x: 0.0, y: -1.0 }

plugins:
  SpriteRendererPlugin:
    sprite: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod.png
  CommandPlugin:
    autoSteerable: true
    Kp: 3.54
    Ki: 0.12
    Kd: 3.12
  ReactionWheelPlugin:
    torque: 5 # kN m
