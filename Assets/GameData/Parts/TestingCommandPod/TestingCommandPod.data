# TestingCommandPod.data

name: Testing Command Pod
mass: 0.8 # t
crossfeed: true

attachmentNodes:
  - name: top
    pos: { x: 0.0, y: 1.0 }
  - name: bottom
    pos: { x: 0.0, y: -1.0 }

plugins:
  SpriteRendererPlugin:
    sprite: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod.png
    material:
      path: Assets/GameData/Parts/Part.mat
      properties:
        _NormalMap:
          type: Texture2D
          value: Assets/GameData/Parts/TestingCommandPod/TestingCommandPod-Normal.png
  CommandPlugin:
    autoSteerable: true
  ReactionWheelPlugin:
    torque: 5 # kN m
